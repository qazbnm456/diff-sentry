# diff-sentry: model roles and runtime knobs.
# Copy this file to `.env`; a live run needs these plus a Deno sandbox.

# --- Model roles (required for a live `pr`/`issue`/`classify` run) ---
# planner: a cheap, injection-resistant orchestrator that holds the diff in the REPL and triages.
DS_ROOT_LM=your-planner-model
# analyst: an expensive model reached via llm_query for a subtle source->sink (short questions only).
DS_SUB_LM=your-analyst-model
# One OpenAI-compatible proxy serves all roles.
# When DS_BASE_URL is set, the model names are the plain ids your endpoint serves (e.g. qwen/qwen3-next), not litellm-prefixed.
DS_BASE_URL=https://your-openai-compatible-endpoint/v1
DS_API_KEY=sk-...

# --- OR: run planner + analyst on a Claude Pro/Max subscription (no API key) ---
# A role with the `claude-agent-sdk/<id>` prefix runs on your Claude subscription through the Claude Agent SDK (`rlm_harness.ClaudeAgentLM`, the `subscription` extra). Each call is a pure completion: no tools, no filesystem, no settings leakage.
# Prerequisites:
#   - `uv sync --extra subscription`
#   - the Claude Code CLI installed and logged in (`claude` then /login, or `claude setup-token` and export CLAUDE_CODE_OAUTH_TOKEN)
#   - `unset ANTHROPIC_API_KEY`: the CLI prefers it over the subscription and would bill API credit, so the adapter refuses to start while it is set
# Prefer full model ids over aliases, which drift.
#   DS_ROOT_LM=claude-agent-sdk/claude-sonnet-5     # planner on Sonnet 5
#   DS_SUB_LM=claude-agent-sdk/claude-fable-5       # analyst on Fable 5
# DS_BASE_URL/DS_API_KEY then serve only the classifier, which always needs an OpenAI-compatible endpoint (a subscription-only run is not supported).
# Set DS_CLASSIFIER_LM to a real model id (plus DS_CLASSIFIER_BASE_URL/DS_CLASSIFIER_API_KEY if it is a separate box).
# Left unset, it inherits the `claude-agent-sdk/…` DS_SUB_LM and config loading fails with an actionable error.
# Budgets use the same env vars as proxy mode.
# Each call adds ~2-5s of CLI-spawn overhead, so keep these runs interactive, not batch.
# DS_PLANNER_MAX_TOKENS has no effect here: the Agent SDK exposes no token or sampling controls.

# --- Second-stage classifier (the swappable seam) ---
# Defaults to the analyst model on DS_BASE_URL/DS_API_KEY.
# Required when the analyst runs on the subscription (see above).
# DS_CLASSIFIER_LM=your-strong-classifier
# DS_CLASSIFIER_BASE_URL=https://your-classifier-endpoint/v1
# DS_CLASSIFIER_API_KEY=sk-...
# DS_CLASSIFIER_CIRCUIT_BREAK=4        # unusable replies in a row before the tool stops calling it
# DS_CLASSIFIER_TIMEOUT=60             # seconds per call, a hard ceiling
# DS_CLASSIFIER_TRANSIENT_RETRIES=1    # re-sends after an endpoint error (not after an unusable reply)
# DS_CLASSIFIER_MAX_TOKENS=2048
# A reasoning model can think through the whole budget and answer nothing; the tool then says it stopped at max_tokens. Raising the cap alone can turn that into a timeout on a slow model; a thinking budget bounds both.
# Extra request parameters (JSON object, single-quoted) apply over the default temperature of 0.1.
# Model, messages, stream, n, timeout, max_tokens and max_completion_tokens are refused (the settings above own them). So is a key the OpenAI client does not take: a parameter only your server knows goes under extra_body.
# DS_CLASSIFIER_LM_KWARGS='{"temperature":1,"extra_body":{"thinking_token_budget":1024}}'

# --- RLM runtime ---
# DS_INTERPRETER=pyodide       # read-not-execute: the sandbox never runs the change. `deno` is an alias.
# DS_MAX_ITERATIONS=25
# DS_MAX_LLM_CALLS=8           # caps only analyst (llm_query) escalations
# DS_ADAPTER=json              # portable structured output (OpenAI + vLLM/NIM)
# DS_PLANNER_MAX_TOKENS=16384  # generous, so a reasoning planner isn't truncated to empty content
# Extra request parameters per role (JSON object, passed as-is; single-quote it, because `uv --env-file` strips double quotes).
# These alias rlm-harness's RLM_MAIN_LM_KWARGS / RLM_SUB_LM_KWARGS, which are read too; setting both to different values is refused.
# A reasoning planner that thinks through the whole cap answers nothing and the run fails; on vLLM a thinking budget below the cap prevents that:
# DS_ROOT_LM_KWARGS='{"extra_body":{"thinking_token_budget":8192}}'
# DS_SUB_LM_KWARGS=             # the analyst only; the classifier builds its own request
# A `max_tokens` here overrides DS_PLANNER_MAX_TOKENS; model, endpoint and timeout keys are refused.

# --- Enrichment fetch (off by default: an exfil surface on attacker-authored input; GitHub-allowlisted) ---
# DS_ENABLE_FETCH=false
# DS_FETCH_ALLOW_CIDRS=198.18.0.0/16   # only if behind a fake-IP proxy / split-DNS VPN

# --- Host-side SIEM emitter (opt-in; deterministic POST after the run) ---
# DS_SIEM_WEBHOOK_URL=https://your-siem/intake
# DS_SIEM_TOKEN=...
# DS_EMIT_ON=suspicious,malicious

# --- Watching a watchlist (`diff-sentry watch`) ---
# Time is the only cost with a local model, so the caps are OFF unless set.
# DS_WATCH_REPOS=owner/name,other/name     # or --repos / --repos-file
# DS_WATCH_PAUSED_REPOS=owner/name         # held, any case: not polled, re-checked, re-alerted or run; its queue waits
# DS_WATCH_STATE_DIR=./output/state        # watch.db, actors.db, snapshots/
# DS_ACCOUNT_HISTORY=clickhouse            # watch/pr/issue/actor: look up authors' public history in GH Archive via ClickHouse's public playground (sends the login there; off by default)
# DS_WATCH_INTERVAL=60                     # seconds between polls (raised if GitHub sends X-Poll-Interval)
# DS_WATCH_BACKFILL_HOURS=0                # on first sight of a repo, also examine changes this recent
# DS_WATCH_RECHECK_HOURS=24                # shorten the re-check schedule (15 min, 1 h, 6 h, 24 h); it cannot extend it
# DS_WATCH_DEEP_MIN_SEVERITY=info          # info = every change goes to the model; raise it to gate on the screen
# DS_WATCH_MAX_QUEUE=0                     # 0 = unbounded; otherwise the lowest priority is shed and recorded
# DS_WATCH_MAX_DEEP_PER_HOUR=0             # 0 = unlimited model runs per hour
# DS_WATCH_WORKERS=1                       # model runs at once; above 1, each in a process of its own
# DS_WATCH_RATE_RESERVE=200                # pause polling when the API's remaining budget falls below this
# DS_RELEASE_PACKAGES=litellm,requests     # release-watch: PyPI projects (or --packages / --packages-file)
# DS_RELEASE_INTERVAL=300                  # release-watch: seconds between polls of each project's index
# DS_RELEASE_MAX_ARTIFACT_MB=256           # release-watch: a larger wheel or sdist is not compared, which alerts
# DS_RELEASE_NPM=@scope/name,left-pad    # release-watch: npm packages (or --npm)
# DS_RELEASE_SOURCES=litellm=BerriAI/litellm  # release-watch: the GitHub repository each package is built from, compared by tag (or --sources)
# DS_RELEASE_IMAGES=ghcr.io/owner/name     # release-watch: container images compared by build provenance (or --images)
# DS_RELEASE_MAX_LAYER_MB=1024            # release-watch: a larger image layer is not read, which alerts
# DS_RELEASE_IMAGE_TAGS=latest             # release-watch: floating tags whose moves are judged (or --image-tags)
